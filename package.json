  "bugs": {
    "url": "https://github.com/andresdelossantos99/ApiRest-Libros/issues"
  },
  "homepage": "https://github.com/andresdelossantos99/ApiRest-Libros#readme",
  "description": "",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}