{
  "name": "api-libros",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/init-db.js",
    "db:setup": "dotenv -- psql -v ON_ERROR_STOP=1 -f config/setup.sql",
    "db:seed": "dotenv -- psql -v ON_ERROR_STOP=1 -f config/seed.sql",
    "db:reset": "npm run db:setup && npm run db:seed",
    "dev:reset": "npm run db:reset && npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresdelossantos99/ApiRest-Libros.git"
  },
  "keywords": [],
